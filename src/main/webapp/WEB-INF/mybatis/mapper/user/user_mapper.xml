<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
           "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="user_mapper">

	<!-- 회원 저장 -->
	<insert id="saveUser" parameterType="com.app.dto.user.User">
		INSERT INTO T_USER (
		id,
		pw,
		name,
		email
		) VALUES (
		#{id},
		#{pw},
		#{name},
		#{email}
		)
	</insert>

	<!-- 전체 조회 -->
	<select id="findUserList" resultType="com.app.dto.user.User">
		SELECT id, pw, name, email
		FROM T_USER
	</select>

	<!-- 이메일 중복 체크 -->
	<select id="countByEmail" parameterType="String"
		resultType="int">
		SELECT COUNT(1)
		FROM T_USER
		WHERE email = #{email}
	</select>

	<!-- 아이디 조회 -->
	<select id="findUserById" parameterType="String"
		resultType="com.app.dto.user.User">
		SELECT id, pw, name, email
		FROM T_USER
		WHERE id = #{id}
	</select>

	<!-- <select id="checkUserLogin" -->
	<!-- parameterType="com.app.dto.user.User" -->
	<!-- resultType="com.app.dto.user.User"> -->
	<!-- SELECT id, pw, name, email -->
	<!-- FROM T_USER -->
	<!-- WHERE id = #{id} -->
	<!-- AND pw -->
	<!-- = #{pw} -->
	<!-- </select> -->
	<select id="checkUserLogin"
		parameterType="com.app.dto.user.User"
		resultType="com.app.dto.user.User">
		SELECT id, pw, name, email
		FROM T_USER
		WHERE id = #{id}
		AND pw = #{pw}
	</select>

	<!-- 비밀번호 수정 -->
	<update id="modifyUserPw" parameterType="com.app.dto.user.User">
		UPDATE T_USER
		SET pw =
		#{pw}
		WHERE id = #{id}
	</update>

	<!-- 회원정보 수정 (userType 제거) -->
	<update id="modifyUser" parameterType="com.app.dto.user.User">
		UPDATE T_USER
		SET pw =
		#{pw},
		name = #{name},
		email = #{email}
		WHERE id = #{id}
	</update>

	<!-- 검색조건에 userType 없이 검색 -->
	<select id="findUserListBySearchCondition"
		parameterType="com.app.dto.user.UserSearchCondition"
		resultType="com.app.dto.user.User">
		SELECT id, pw, name, email
		FROM T_USER
		<where>
			<if test="searchKeyword != null and searchKeyword != ''">
				( id LIKE CONCAT('%', #{searchKeyword}, '%')
				OR name LIKE
				CONCAT('%', #{searchKeyword}, '%') )
			</if>
		</where>
	</select>

	<!-- 회원 삭제 예시 -->
	<delete id="deleteUserById" parameterType="String">
		DELETE FROM T_USER
		WHERE id = #{id}
	</delete>

</mapper>
